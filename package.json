{
  "name": "bookstore",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:webdriver": "cd tests/webdriver && wdio wdio.conf.js",
    "kill-ports": "kill-port 3000 5000 19006 || true",
    "start:backend": "cd backend && python run.py",
    "start:web": "cd web && npm start",
    "start:mobile": "cd mobile && npm start",
    "start:all": "npm run kill-ports && npm run start:backend & npm run start:web & npm run start:mobile"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.18.2",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "axios": "^1.6.7",
    "expo": "~50.0.6",
    "expo-status-bar": "~1.11.1",
    "react": "18.2.0",
    "react-native": "0.73.4",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "typescript": "^5.1.3"
  },
  "private": true
}
